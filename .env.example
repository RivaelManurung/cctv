# ---------------------------------------------------------------------------
# CCTV Indonesia — environment template
# ---------------------------------------------------------------------------
# This application is frontend-only: it has NO backend, NO database and needs
# NO API keys. Every camera, city, province and source is defined statically in
# src/data/. The only variable below is used for absolute URLs in metadata,
# the sitemap, robots.txt and share links.
#
# Copy to `.env.local` and adjust for your deployment:
#
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# Canonical origin of the deployed site. No trailing slash.
# Used by src/lib/site.ts for:
#   - metadataBase / canonical URLs / Open Graph URLs
#   - src/app/sitemap.ts
#   - src/app/robots.ts
#   - the "copy link" / Web Share actions
# Defaults to https://cctv-indonesia.vercel.app when unset.
NEXT_PUBLIC_SITE_URL=https://cctv-indonesia.vercel.app
